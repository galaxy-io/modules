{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "skip-changelog": true,
  "bump-minor-pre-major": true,
  "release-type": "go",
  "tag-separator": "/",
  "packages": {
    "secret": {
      "component": "secret",
      "exclude-paths": ["secret/aws", "secret/gcp"]
    },
    "secret/aws": {
      "component": "secret/aws"
    },
    "secret/gcp": {
      "component": "secret/gcp"
    }
  }
}
